@model List<DataPlaneConfigResponse>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-grid me-2"></i>Data Plane Configurations</h5>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No data planes found for this site. Check your API key and Site ID configuration.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data Plane</th>
                        <th>Pending Config</th>
                        <th>Last Applied</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dp in Model)
                    {
                        <tr>
                            <td class="fw-semibold align-middle">@dp.DataPlane</td>
                            <td class="align-middle">
                                @if (dp.Pending != null)
                                {
                                    <span class="badge bg-warning text-dark me-1">v@(dp.Pending.Version)</span>
                                    <small class="text-muted">sent @dp.Pending.SentAt?.ToString("yyyy-MM-dd HH:mm")</small>
                                }
                                else
                                {
                                    <span class="text-muted small">Up to date</span>
                                }
                            </td>
                            <td class="align-middle">
                                @if (dp.LastApplied != null)
                                {
                                    <span class="badge bg-success me-1">v@(dp.LastApplied.Version)</span>
                                    <small class="text-muted">@dp.LastApplied.AppliedAt?.ToString("yyyy-MM-dd HH:mm")</small>
                                }
                                else
                                {
                                    <span class="text-muted small">Never applied</span>
                                }
                            </td>
                            <td class="align-middle">
                                @if (dp.Pending != null)
                                {
                                    <a asp-action="Config" asp-route-dataPlaneId="@dp.DataPlaneId"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye me-1"></i>Review Change
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
