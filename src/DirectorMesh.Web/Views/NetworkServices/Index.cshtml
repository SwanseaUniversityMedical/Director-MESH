@model IEnumerable<NetworkService>
@{
    ViewData["Title"] = "Services";
    var filterSite = ViewBag.FilterSite as Site;
}

@section TopbarActions {
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>New Service
    </a>
}

@if (filterSite != null)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
        <i class="bi bi-funnel-fill"></i>
        Showing services for <strong>@filterSite.Name</strong>
        <a asp-action="Index" class="ms-2 btn btn-sm btn-outline-secondary py-0">Clear filter</a>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Site</th>
                    <th>Data Plane</th>
                    <th>Direction</th>
                    <th>Protocol</th>
                    <th>Port</th>
                    <th>Endpoint / Remote</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var svc in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@svc.Id" class="text-decoration-none">@svc.Name</a>
                        </td>
                        <td>
                            <a asp-controller="Sites" asp-action="Details" asp-route-id="@svc.SiteId"
                               class="text-decoration-none text-muted small">@svc.Site.Name</a>
                        </td>
                        <td class="text-muted small">@svc.DataPlane.Name</td>
                        <td>
                            @if (svc.Direction == ServiceDirection.Inbound)
                            {
                                <span class="badge bg-info text-dark"><i class="bi bi-arrow-down-left"></i> Inbound</span>
                            }
                            else
                            {
                                <span class="badge bg-primary"><i class="bi bi-arrow-up-right"></i> Outbound</span>
                            }
                        </td>
                        <td>@svc.Protocol</td>
                        <td><strong>@svc.Port</strong></td>
                        <td class="small">
                            @if (svc.Direction == ServiceDirection.Inbound)
                            { <code class="text-muted">@svc.LocalEndpoint</code> }
                            else
                            { <code class="text-muted">@svc.RemoteNetBirdDnsName</code> }
                        </td>
                        <td>
                            <span class="badge @(svc.IsEnabled ? "bg-success" : "bg-secondary")">
                                @(svc.IsEnabled ? "Enabled" : "Disabled")
                            </span>
                        </td>
                        <td class="table-action-btns text-end">
                            <a asp-action="Edit" asp-route-id="@svc.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@svc.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No services found. <a asp-action="Create">Create one</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
