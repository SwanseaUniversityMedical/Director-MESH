@model NetworkServiceCreateEditViewModel
@{
    ViewData["Title"] = $"Edit — {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-pencil me-2"></i>Edit Network Service</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Enabled</label>
                            <div class="form-check form-switch mt-1">
                                <input asp-for="IsEnabled" class="form-check-input" type="checkbox" role="switch" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SiteId" class="form-label fw-semibold"></label>
                            <select asp-for="SiteId" asp-items="Model.Sites" class="form-select" id="siteSelect"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DataPlaneId" class="form-label fw-semibold"></label>
                            <select asp-for="DataPlaneId" asp-items="Model.DataPlanes" class="form-select" id="dataPlaneSelect">
                                <option value="">— Select Data Plane —</option>
                            </select>
                            <span asp-validation-for="DataPlaneId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Direction" class="form-label fw-semibold"></label>
                            <select asp-for="Direction" asp-items="Html.GetEnumSelectList<ServiceDirection>()" class="form-select" id="directionSelect"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Protocol" class="form-label fw-semibold"></label>
                            <select asp-for="Protocol" asp-items="Html.GetEnumSelectList<ServiceProtocol>()" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Port" class="form-label fw-semibold"></label>
                            <input asp-for="Port" class="form-control" type="number" />
                        </div>
                        <div class="col-12" id="localEndpointRow">
                            <label asp-for="LocalEndpoint" class="form-label fw-semibold">Local Endpoint <span class="badge bg-info text-dark">Inbound</span></label>
                            <input asp-for="LocalEndpoint" class="form-control" />
                        </div>
                        <div class="col-12" id="remoteEndpointRow">
                            <label asp-for="RemoteNetBirdDnsName" class="form-label fw-semibold">Remote NetBird DNS <span class="badge bg-primary">Outbound</span></label>
                            <input asp-for="RemoteNetBirdDnsName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NetBirdPeerName" class="form-label fw-semibold"></label>
                            <input asp-for="NetBirdPeerName" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NetBirdDnsName" class="form-label fw-semibold"></label>
                            <input asp-for="NetBirdDnsName" class="form-control" disabled="disabled" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NetBirdIpAddress" class="form-label fw-semibold"></label>
                            <input asp-for="NetBirdIpAddress" class="form-control" disabled="disabled" />
                        </div>
                        <div class="col-12">
                            <label asp-for="NetBirdSetupKey" class="form-label fw-semibold"></label>
                            <input asp-for="NetBirdSetupKey" class="form-control font-monospace" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function updateEndpointVisibility() {
            const dir = document.getElementById('directionSelect').value;
            console.log('Direction selected: ' + dir);
            document.getElementById('localEndpointRow').style.display = dir === '0' ? '' : 'none';
            document.getElementById('remoteEndpointRow').style.display = dir === '1' ? '' : 'none';
        }
        document.getElementById('directionSelect').addEventListener('change', updateEndpointVisibility);
        updateEndpointVisibility();

        const siteDataPlaneMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SiteDataPlaneMap));
        const allDataPlaneOptions = Array.from(document.getElementById('dataPlaneSelect').options)
            .map(o => ({ value: o.value, text: o.text }));
        function updateDataPlaneOptions() {
            const siteId = document.getElementById('siteSelect').value;
            const allowedIds = (siteDataPlaneMap[siteId] || []).map(String);
            const select = document.getElementById('dataPlaneSelect');
            const currentValue = select.value;
            select.innerHTML = '';
            const placeholder = new Option('— Select Data Plane —', '');
            select.add(placeholder);
            allDataPlaneOptions
                .filter(o => o.value !== '' && allowedIds.includes(o.value))
                .forEach(o => select.add(new Option(o.text, o.value, false, o.value === currentValue)));
        }
        document.getElementById('siteSelect').addEventListener('change', updateDataPlaneOptions);
        updateDataPlaneOptions();
    </script>
}
