@model IEnumerable<Site>
@{
    ViewData["Title"] = "Sites / TREs";
    var filterDp = ViewBag.FilterDataPlane as DataPlane;
}

@section TopbarActions {
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>New Site
    </a>
}

@if (filterDp != null)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
        <i class="bi bi-funnel-fill"></i>
        Showing sites in <strong>@filterDp.Name</strong>
        <a asp-action="Index" class="ms-2 btn btn-sm btn-outline-secondary py-0">Clear filter</a>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Data Planes</th>
                    <th class="text-center">Services</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var site in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@site.Id" class="text-decoration-none">@site.Name</a>
                        </td>
                        <td class="small text-muted">
                            @string.Join(", ", site.DataPlanes.OrderBy(dp => dp.Name).Select(dp => dp.Name))
                        </td>
                        <td class="text-center">
                            <a asp-controller="NetworkServices" asp-action="Index" asp-route-siteId="@site.Id"
                               class="badge bg-secondary text-decoration-none">@site.Services.Count</a>
                        </td>
                        <td>
                            @{
                                var badge = site.Status switch {
                                    SiteStatus.Active => "bg-success",
                                    SiteStatus.Inactive => "bg-secondary",
                                    SiteStatus.Error => "bg-danger",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @badge">@site.Status</span>
                        </td>
                        <td class="table-action-btns text-end">
                            <a asp-action="Edit" asp-route-id="@site.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@site.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No sites found. <a asp-action="Create">Create one</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
