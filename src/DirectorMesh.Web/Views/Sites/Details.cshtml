@model Site
@{
    ViewData["Title"] = Model.Name;
    var badge = Model.Status switch {
        SiteStatus.Active => "bg-success",
        SiteStatus.Inactive => "bg-secondary",
        SiteStatus.Error => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

@section TopbarActions {
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-pencil me-1"></i>Edit
    </a>
    <form asp-controller="SiteConfigurations" asp-action="Generate" method="post" class="d-inline">
        <input type="hidden" name="siteId" value="@Model.Id" />
        <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-gear me-1"></i>Generate Config
        </button>
    </form>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-info-circle me-2"></i>Site Details</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Status</dt>
                    <dd class="col-7"><span class="badge @badge">@Model.Status</span></dd>
                    <dt class="col-5">Data Planes</dt>
                    <dd class="col-7">
                        @foreach (var dp in Model.DataPlanes.OrderBy(dp => dp.Name))
                        {
                            <a asp-controller="DataPlanes" asp-action="Details" asp-route-id="@dp.Id"
                               class="badge bg-secondary text-decoration-none me-1">@dp.Name</a>
                        }
                        @if (!Model.DataPlanes.Any()) { <span class="text-muted">—</span> }
                    </dd>
                    <dt class="col-5">Agent API Key</dt>
                    <dd class="col-7">
                        @if (Model.ApiKey != null)
                        { <code class="text-muted small">@Model.ApiKey[..Math.Min(8, Model.ApiKey.Length)]…</code> }
                        else
                        { <span class="text-muted small">Not set</span> }
                    </dd>
                    <dt class="col-5">Created</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <hr class="my-2"/>
                    <p class="small text-muted mb-0">@Model.Description</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-arrow-left-right me-2"></i>Services (@Model.Services.Count)</span>
                <a asp-controller="NetworkServices" asp-action="Create" asp-route-siteId="@Model.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus"></i> Add Service
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 small">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Data Plane</th><th>Direction</th><th>Protocol</th><th>Port</th><th>Endpoint</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in Model.Services.OrderBy(s => s.Direction).ThenBy(s => s.Name))
                        {
                            <tr>
                                <td><a asp-controller="NetworkServices" asp-action="Details" asp-route-id="@svc.Id" class="text-decoration-none fw-semibold">@svc.Name</a></td>
                                <td>
                                    <a asp-controller="DataPlanes" asp-action="Details" asp-route-id="@svc.DataPlaneId" class="text-decoration-none text-muted">@svc.DataPlane.Name</a>
                                </td>
                                <td>
                                    @if (svc.Direction == ServiceDirection.Inbound)
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-arrow-down-left"></i> Inbound</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-arrow-up-right"></i> Outbound</span>
                                    }
                                </td>
                                <td>@svc.Protocol</td>
                                <td><strong>@svc.Port</strong></td>
                                <td>
                                    @if (svc.Direction == ServiceDirection.Inbound)
                                    { <code class="text-muted">@svc.LocalEndpoint</code> }
                                    else
                                    { <code class="text-muted">@svc.RemoteNetBirdDnsName</code> }
                                </td>
                                <td><span class="badge @(svc.IsEnabled ? "bg-success" : "bg-secondary")">@(svc.IsEnabled ? "On" : "Off")</span></td>
                                <td><a asp-controller="NetworkServices" asp-action="Edit" asp-route-id="@svc.Id" class="btn btn-sm btn-outline-secondary py-0"><i class="bi bi-pencil"></i></a></td>
                            </tr>
                        }
                        @if (!Model.Services.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted py-3">No services defined.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-send me-2"></i>Recent Configurations</span>
                <a asp-controller="SiteConfigurations" asp-action="Index" asp-route-siteId="@Model.Id" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 small">
                    <thead class="table-light">
                        <tr><th>Version</th><th>Status</th><th>Created</th><th>Sent</th><th>Approved</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var cfg in Model.Configurations.OrderByDescending(c => c.Version))
                        {
                            var cfgBadge = cfg.Status switch {
                                ConfigurationStatus.Applied => "bg-success",
                                ConfigurationStatus.Approved => "bg-info text-dark",
                                ConfigurationStatus.Sent => "bg-warning text-dark",
                                ConfigurationStatus.Rejected => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td><a asp-controller="SiteConfigurations" asp-action="Details" asp-route-id="@cfg.Id" class="text-decoration-none">v@(cfg.Version)</a></td>
                                <td><span class="badge @cfgBadge">@cfg.Status</span></td>
                                <td>@cfg.CreatedAt.ToString("MM-dd HH:mm")</td>
                                <td>@(cfg.SentAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                                <td>@(cfg.ApprovedAt?.ToString("MM-dd HH:mm") ?? "—")</td>
                                <td><a asp-controller="SiteConfigurations" asp-action="Details" asp-route-id="@cfg.Id" class="btn btn-sm btn-outline-secondary py-0"><i class="bi bi-arrow-right"></i></a></td>
                            </tr>
                        }
                        @if (!Model.Configurations.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">No configurations generated yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
