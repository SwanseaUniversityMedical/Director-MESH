@model SiteCreateEditViewModel
@{
    ViewData["Title"] = "New Site";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-buildings me-2"></i>Create Site / TRE</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Oxford TRE" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<SiteStatus>()" class="form-select"></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="DataPlaneIds" class="form-label fw-semibold"></label>
                            <select asp-for="DataPlaneIds" asp-items="Model.DataPlanes" class="form-select" multiple size="4"></select>
                            <div class="form-text">Hold Ctrl / Cmd to select multiple data planes.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="ApiKey" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="ApiKey" class="form-control font-monospace" id="apiKeyInput" />
                                <button type="button" class="btn btn-outline-secondary" onclick="generateApiKey()">Generate</button>
                            </div>
                            <div class="form-text">Used by the Site Agent to authenticate. Keep this secret.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Create</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function generateApiKey() {
            const arr = new Uint8Array(24);
            crypto.getRandomValues(arr);
            document.getElementById('apiKeyInput').value = Array.from(arr, b => b.toString(16).padStart(2,'0')).join('');
        }
    </script>
}
