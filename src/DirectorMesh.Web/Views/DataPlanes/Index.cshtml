@model IEnumerable<DataPlane>
@{
    ViewData["Title"] = "Data Planes";
}

@section TopbarActions {
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>New Data Plane
    </a>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>NetBird Network ID</th>
                    <th class="text-center">Sites</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dp in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@dp.Id" class="text-decoration-none">@dp.Name</a>
                        </td>
                        <td class="text-muted">@dp.Description</td>
                        <td><code class="small">@dp.NetBirdNetworkId</code></td>
                        <td class="text-center">
                            <a asp-controller="Sites" asp-action="Index" asp-route-dataPlaneId="@dp.Id"
                               class="badge bg-secondary text-decoration-none">@dp.Sites.Count</a>
                        </td>
                        <td class="text-muted small">@dp.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="table-action-btns text-end">
                            <a asp-action="Edit" asp-route-id="@dp.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@dp.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No data planes yet. <a asp-action="Create">Create one</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
