<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Director-MESH</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { overflow-x: hidden; }
        #sidebar {
            min-height: 100vh;
            background: #1a2332;
            width: 260px;
            flex-shrink: 0;
        }
        #sidebar .brand {
            padding: 1.5rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }
        #sidebar .brand-title { color: #fff; font-weight: 700; font-size: 1.2rem; letter-spacing: .5px; }
        #sidebar .brand-sub { color: #8899aa; font-size: .75rem; letter-spacing: 1px; text-transform: uppercase; }
        #sidebar .nav-section { padding: .75rem 1rem .25rem; color: #8899aa; font-size: .7rem; text-transform: uppercase; letter-spacing: 1px; }
        #sidebar .nav-link {
            color: #b0bec5;
            padding: .5rem 1.25rem;
            border-radius: 6px;
            margin: 1px 8px;
            font-size: .9rem;
            transition: background .15s, color .15s;
        }
        #sidebar .nav-link:hover, #sidebar .nav-link.active {
            background: rgba(255,255,255,.1);
            color: #fff;
        }
        #sidebar .nav-link i { width: 1.4rem; }
        #sidebar .sidebar-footer {
            border-top: 1px solid rgba(255,255,255,.1);
            padding: 1rem 1.25rem;
            margin-top: auto;
        }
        #main { flex: 1; min-width: 0; background: #f8f9fa; }
        #topbar {
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: .75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .page-content { padding: 1.5rem; }
        .status-badge { font-size: .75rem; }
        .card { border: 1px solid #dee2e6; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
        .stat-card { border-left: 4px solid; }
        .table-action-btns .btn { padding: .25rem .5rem; font-size: .8rem; }
        pre.config-block { background: #1e1e2e; color: #cdd6f4; border-radius: 8px; padding: 1rem; font-size: .8rem; max-height: 400px; overflow-y: auto; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav id="sidebar" class="d-flex flex-column">
        <div class="brand">
            <div class="brand-title"><i class="bi bi-diagram-3-fill me-2"></i>Director-MESH</div>
            <div class="brand-sub">Network Mesh Control Plane</div>
        </div>

        <div class="pt-2">
            <div class="nav-section">Overview</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section mt-2">Configuration</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DataPlanes" ? "active" : "")"
               asp-controller="DataPlanes" asp-action="Index">
                <i class="bi bi-layers"></i> Data Planes
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sites" ? "active" : "")"
               asp-controller="Sites" asp-action="Index">
                <i class="bi bi-buildings"></i> Sites / TREs
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NetworkServices" ? "active" : "")"
               asp-controller="NetworkServices" asp-action="Index">
                <i class="bi bi-arrow-left-right"></i> Services
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AclRules" ? "active" : "")"
               asp-controller="AclRules" asp-action="Index">
                <i class="bi bi-shield-check"></i> ACL Rules
            </a>

            <div class="nav-section mt-2">Deployment</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SiteConfigurations" ? "active" : "")"
               asp-controller="SiteConfigurations" asp-action="Index">
                <i class="bi bi-send"></i> Site Configs
            </a>
        </div>

        <div class="sidebar-footer mt-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white"
                         style="width:32px;height:32px;font-size:.85rem;flex-shrink:0">
                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div style="min-width:0">
                        <div class="text-white text-truncate" style="font-size:.85rem">@User.Identity.Name</div>
                    </div>
                </div>
                <a href="/signout-callback" class="btn btn-sm btn-outline-secondary w-100">
                    <i class="bi bi-box-arrow-right me-1"></i>Sign out
                </a>
            }
        </div>
    </nav>

    <div id="main" class="d-flex flex-column">
        <div id="topbar">
            <h6 class="mb-0 fw-semibold text-secondary">@ViewData["Title"]</h6>
            <div class="ms-auto d-flex gap-2">
                @RenderSection("TopbarActions", required: false)
            </div>
        </div>

        <div class="page-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
