@model SiteConfiguration
@{
    ViewData["Title"] = $"{Model.Site.Name} — Config v{Model.Version}";
    var badge = Model.Status switch {
        ConfigurationStatus.Applied => "bg-success",
        ConfigurationStatus.Approved => "bg-info text-dark",
        ConfigurationStatus.Sent => "bg-warning text-dark",
        ConfigurationStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}

@section TopbarActions {
    @if (Model.Status == ConfigurationStatus.Draft)
    {
        <form asp-action="Send" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-send me-1"></i>Mark as Sent</button>
        </form>
    }
    @if (Model.Status == ConfigurationStatus.Sent)
    {
        <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-circle me-1"></i>Approve</button>
        </form>
        <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
            <i class="bi bi-x-circle me-1"></i>Reject
        </button>
    }
    @if (Model.Status == ConfigurationStatus.Approved)
    {
        <form asp-action="MarkApplied" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check2-all me-1"></i>Mark Applied</button>
        </form>
    }
    <a asp-action="DownloadK8s" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-download me-1"></i>Download K8s yaml
    </a>
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">Status</div>
            <span class="badge @badge fs-6 mt-1">@Model.Status</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">Version</div>
            <div class="fs-4 fw-bold">v@(Model.Version)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">Site</div>
            <div class="fw-semibold">
                <a asp-controller="Sites" asp-action="Details" asp-route-id="@Model.SiteId" class="text-decoration-none">@Model.Site.Name</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3">
            <div class="text-muted small">Data Planes</div>
            <div class="fw-semibold text-muted small mt-1">@string.Join(", ", Model.Site.DataPlanes.Select(dp => dp.Name))</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header bg-white fw-semibold small"><i class="bi bi-clock-history me-2"></i>Timeline</div>
            <div class="card-body small">
                <div class="d-flex align-items-start gap-2 mb-2">
                    <i class="bi bi-circle-fill text-secondary mt-1" style="font-size:.6rem"></i>
                    <div><strong>Created</strong><br><span class="text-muted">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span></div>
                </div>
                <div class="d-flex align-items-start gap-2 mb-2 @(Model.SentAt == null ? "text-muted" : "")">
                    <i class="bi bi-circle-fill @(Model.SentAt != null ? "text-warning" : "text-light border border-secondary") mt-1" style="font-size:.6rem"></i>
                    <div><strong>Sent</strong><br><span class="text-muted">@(Model.SentAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></div>
                </div>
                <div class="d-flex align-items-start gap-2 mb-2">
                    <i class="bi bi-circle-fill @(Model.ApprovedAt != null ? "text-info" : "text-light border border-secondary") mt-1" style="font-size:.6rem"></i>
                    <div><strong>Approved</strong><br><span class="text-muted">@(Model.ApprovedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></div>
                </div>
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-circle-fill @(Model.AppliedAt != null ? "text-success" : "text-light border border-secondary") mt-1" style="font-size:.6rem"></i>
                    <div><strong>Applied</strong><br><span class="text-muted">@(Model.AppliedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span></div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ApprovalToken))
                {
                    <hr class="my-2"/>
                    <div class="text-muted">Approval Token</div>
                    <code class="small">@Model.ApprovalToken</code>
                }
                @if (!string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <hr class="my-2"/>
                    <div class="text-danger small"><strong>Rejection:</strong> @Model.RejectionReason</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <ul class="nav nav-tabs mb-2" id="configTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-k8s">K8s Manifest</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-json">Full JSON</button>
            </li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-k8s">
                <pre class="config-block">@Model.K8sManifestYaml</pre>
            </div>
            <div class="tab-pane fade" id="tab-json">
                <pre class="config-block">@Model.ConfigurationJson</pre>
            </div>
        </div>
    </div>
</div>

@if (Model.Status == ConfigurationStatus.Sent)
{
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Reject Configuration</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                    <div class="modal-body">
                        <label class="form-label small fw-semibold">Reason (optional)</label>
                        <textarea name="reason" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
