@model AclRule
@{
    ViewData["Title"] = $"Delete — {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white fw-semibold">
                <i class="bi bi-exclamation-triangle me-2"></i>Confirm Deletion
            </div>
            <div class="card-body">
                <p>Delete ACL rule <strong>@Model.Name</strong>?</p>
                <dl class="row small">
                    <dt class="col-5">Source</dt>
                    <dd class="col-7">@Model.SourceService?.Site?.Name / @Model.SourceService?.Name</dd>
                    <dt class="col-5">Destination</dt>
                    <dd class="col-7">@Model.DestinationService?.Site?.Name / @Model.DestinationService?.Name</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
