@model AclRule
@{
    ViewData["Title"] = Model.Name;
}

@section TopbarActions {
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-pencil me-1"></i>Edit
    </a>
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-info-circle me-2"></i>Rule Details</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Data Plane</dt>
                    <dd class="col-7"><a asp-controller="DataPlanes" asp-action="Details" asp-route-id="@Model.DataPlaneId" class="text-decoration-none">@Model.DataPlane.Name</a></dd>
                    <dt class="col-5">Action</dt>
                    <dd class="col-7"><span class="badge @(Model.Action == AclAction.Allow ? "bg-success" : "bg-danger") fs-6">@Model.Action</span></dd>
                    <dt class="col-5">Status</dt>
                    <dd class="col-7"><span class="badge @(Model.IsEnabled ? "bg-success" : "bg-secondary")">@(Model.IsEnabled ? "Enabled" : "Disabled")</span></dd>
                    <dt class="col-5">Created</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <hr class="my-2"/>
                    <p class="small text-muted mb-0">@Model.Description</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-arrow-up-right me-2 text-primary"></i>Source — Outbound Service</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-4">Site</dt>
                    <dd class="col-8"><a asp-controller="Sites" asp-action="Details" asp-route-id="@Model.SourceService.SiteId" class="text-decoration-none">@Model.SourceService.Site.Name</a></dd>
                    <dt class="col-4">Data Planes</dt>
                    <dd class="col-8 text-muted">@string.Join(", ", Model.SourceService.Site.DataPlanes.Select(dp => dp.Name))</dd>
                    <dt class="col-4">Service</dt>
                    <dd class="col-8"><a asp-controller="NetworkServices" asp-action="Details" asp-route-id="@Model.SourceServiceId" class="text-decoration-none fw-semibold">@Model.SourceService.Name</a></dd>
                    <dt class="col-4">Protocol</dt>
                    <dd class="col-8">@Model.SourceService.Protocol:@Model.SourceService.Port</dd>
                </dl>
            </div>
        </div>
        <div class="card">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-arrow-down-left me-2 text-info"></i>Destination — Inbound Service</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-4">Site</dt>
                    <dd class="col-8"><a asp-controller="Sites" asp-action="Details" asp-route-id="@Model.DestinationService.SiteId" class="text-decoration-none">@Model.DestinationService.Site.Name</a></dd>
                    <dt class="col-4">Data Planes</dt>
                    <dd class="col-8 text-muted">@string.Join(", ", Model.DestinationService.Site.DataPlanes.Select(dp => dp.Name))</dd>
                    <dt class="col-4">Service</dt>
                    <dd class="col-8"><a asp-controller="NetworkServices" asp-action="Details" asp-route-id="@Model.DestinationServiceId" class="text-decoration-none fw-semibold">@Model.DestinationService.Name</a></dd>
                    <dt class="col-4">Protocol</dt>
                    <dd class="col-8">@Model.DestinationService.Protocol:@Model.DestinationService.Port</dd>
                    <dt class="col-4">Local Endpoint</dt>
                    <dd class="col-8"><code>@(Model.DestinationService.LocalEndpoint ?? "—")</code></dd>
                </dl>
            </div>
        </div>
    </div>
</div>
