# Copy this file to .env and fill in the values.
# See docker-compose.siteagent.yml for usage.

# Base URL of the Director-MESH web app.
# When running both stacks locally on Docker Desktop use host.docker.internal.
# On Linux use: http://172.17.0.1:5000
DIRECTOR_MESH_URL=http://host.docker.internal:5000

# Numeric site ID from the Director-MESH Sites list.
DIRECTOR_MESH_SITE=1

# API key from the site's Edit page in Director-MESH.
DIRECTOR_MESH_KEY=

# Host port the site agent will be available on (default 5100).
SITE_AGENT_PORT=5100
