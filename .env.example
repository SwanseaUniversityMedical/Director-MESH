# Copy this file to .env and fill in the values.
# See docker-compose.siteagent.yml for usage.

# Base URL of the Director-MESH web app.
# When running both stacks locally on Docker Desktop use host.docker.internal.
# On Linux use: http://172.17.0.1:5000
DIRECTOR_MESH_URL=http://host.docker.internal:5000

# Numeric site ID from the Director-MESH Sites list.
DIRECTOR_MESH_SITE=1

# API key from the site's Edit page in Director-MESH.
DIRECTOR_MESH_KEY=

# Host port the site agent will be available on (default 5100).
SITE_AGENT_PORT=5100

# Gitea
GITEA_PORT=3000
GITEA_DOMAIN=localhost
GITEA_ADMIN_USER=gitea
GITEA_ADMIN_PASSWORD=           # Set a strong password before first boot — cannot be changed via env after init
GITEA_SECRET_KEY=               # Random string used for cookie signing — set once and keep stable
GITEA_REPO=director-mesh-configs

# Optional: URL ArgoCD uses to clone the repo. Set this if ArgoCD runs outside the Docker
# network and needs a different hostname to reach Gitea.
# GITEA_REPO_URL=http://gitea.example.com/gitea/director-mesh-configs.git
